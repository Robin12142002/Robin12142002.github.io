    </div>
    <div class="nUOEg">
      <svg viewBox="0 0 270 11" xmlns="http://www.w3.org/2000/svg">
        <path d="...省略分隔線 SVG 路徑..." fill="rgb(192, 150, 98)"></path>
      </svg>
    </div>
  </div>
</div>

<!-- 捲到式聲音播放 -->
<div id="0e4a21d5-7c3c-43e4-a44e-dfa19814dbb2">
