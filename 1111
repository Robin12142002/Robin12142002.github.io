  <!-- 聲音提示樣式 -->
  <style data-styled="iiYZtM nisHg sctpX nUOEg" data-styled-version="4.4.1">
    .iiYZtM{display:flex;flex-direction:column;align-items:center;gap:16px;margin:auto;width:calc(100vw - 68px);} 
    @media (min-width:768px){.iiYZtM{padding-left:24px;padding-right:24px;}} 
    @media (min-width:768px) and (max-width:1023px){.iiYZtM{width:453px;}} 
    @media (min-width:1024px) and (max-width:1439px){.iiYZtM{width:480px;}} 
    @media (min-width:1440px){.iiYZtM{width:580px;}}
    .sctpX{display:flex;justify-content:center;align-items:center;gap:4px;padding:4px 12px;border-radius:40px;cursor:pointer;} 
    .sctpX > span{font-size:14px;font-family:Noto Sans TC,Sans-Serif,serif;font-weight:500;line-height:21px;} 
    .sctpX > svg{width:18px;height:18px;} 
    .sctpX.dark{background-color:#404040;color:#fff;} 
    .sctpX.dark svg{fill:#fff;} 
    .sctpX.light{background-color:#fff;color:#404040;} 
    .sctpX.light svg{fill:#404040;} 
    @media (hover:hover){.sctpX.dark:hover{background-color:#000;}.sctpX.light:hover{background-color:#e2e2e2;}}
    .nisHg{margin:0;text-align:center;font-family:Noto Sans TC,Sans-Serif,serif;font-weight:400;font-size:14px;line-height:21px;color:#808080;}
    .nUOEg{width:192px;margin-top:24px;} 
    @media (min-width:1440px){.nUOEg{width:272px;}}
    .elszZf{min-height:10px;}
  </style>
</head>
<body>

<!-- 捲動式圖片 -->
<div id="e300c1f1-12d2-4022-a77a-dd239936b217"></div>

<!-- 聲音提示區塊 -->
<div id="190035a5-5072-452f-ad07-2cf365a56f75">
